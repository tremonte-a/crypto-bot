# ─── Database ──────────────────────────────────────────────────────────
# Full connection string (used by Drizzle ORM and migrations)
DATABASE_URL=postgresql://postgres:password@localhost:5432/crypto_bot

# ─── Kraken API ──────────────────────────────────────────────────────
# Get these from your Kraken account → API Keys
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# Set to 'true' to simulate orders without real funds (safe for testing)
PAPER_MODE=true

# ─── Admin Authentication ────────────────────────────────────────────
# Password to access admin controls on the dashboard
ADMIN_PASSWORD=your_strong_password

# Secret key used to sign JWT tokens (generate a random 32+ character string)
JWT_SECRET=your_jwt_secret_here

# ─── Discord Notifications (optional) ──────────────────────────────
# Webhook URL for order placement, fills, cancellations, and errors
DISCORD_WEBHOOK_URL=

# ─── Server ──────────────────────────────────────────────────────────
# Port the backend API listens on (default: 4000)
PORT=4000